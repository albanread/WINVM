"float_arith_both_tiers.mst — WINVM Phase 5: FConst/FUnbox/FArith/
 FCmpBr/FCmpVal/FBox executing under the x64 back end. Must agree with
 the interpreter."

Object subclass: FT [
    poly: x [
        | a |
        a := (x * x) + (x * 2.5) - 1.25.
        ^a / 2.0
    ]
    cmp: x [
        ^(x > 3.5) ifTrue: [ 1 ] ifFalse: [ 0 ]
    ]
]
F := FT new.
R := 0.0.
1 to: 500 do: [ :k | R := F poly: 3.5 ].
Transcript showCr: R printString.
S := 0.
1 to: 500 do: [ :k | S := F cmp: 3.5 ].
Transcript showCr: S printString.
T := 0.
1 to: 500 do: [ :k | T := F cmp: 9.0 ].
Transcript showCr: T printString.
